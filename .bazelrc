# SPDX-License-Identifier: Apache-2.0
common --enable_bzlmod
common --check_direct_dependencies=off

build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build -c opt
build --copt=-O3

# ⛔ No fused multiply-add contraction. A contracted `a*b + c` rounds once instead of twice, so the
# same source yields different doubles depending on whether the compiler fused it — and the solver's
# pivots, bounds and tie-breaks follow those doubles. With contraction off (and no fast-math), the
# result of each operation is fixed by IEEE 754, whatever the optimiser inlines or reorders.
build --copt=-ffp-contract=off --host_copt=-ffp-contract=off

build --dynamic_mode=off
build --per_file_copt=.*external/.*@-w
build --host_per_file_copt=.*external/.*@-w

common --enable_platform_specific_config
build:macos --macos_minimum_os=13.3
build:macos --host_macos_minimum_os=13.3
